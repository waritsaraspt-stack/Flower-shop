# ==============================================================
# BloomPOS - Environment Variables Example
# คัดลอกไฟล์นี้เป็น .env.local แล้วกรอกข้อมูลจริงจาก Supabase Dashboard
# ==============================================================

# 1. Supabase Project URL & Anon Key (ได้จาก Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. (Optional) Service Role Key สำหรับ Edge Functions หรือ Script จัดการแอดมิน
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
